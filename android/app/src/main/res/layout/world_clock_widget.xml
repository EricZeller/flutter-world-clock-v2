<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background_white"
        android:scaleType="fitXY"
        android:alpha="0.9" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Berlin"
            android:textColor="#0aaea6"
            android:textSize="18sp"
            android:fontFamily="@font/pacifico_family"
            android:gravity="center"
            android:shadowColor="#20000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <TextClock
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:fontFamily="@font/red_hat_display_family"
            android:gravity="center"
            android:layout_marginTop="-4dp"
            android:shadowColor="#30000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, d. MMM"
            android:format24Hour="EEE, d. MMM"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/red_hat_display_family"
            android:gravity="center"
            android:alpha="0.8"
            android:layout_marginTop="-2dp" />

        <TextView
            android:id="@+id/widget_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️ 20°C"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/red_hat_display_family"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:shadowColor="#20000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

    </LinearLayout>

</FrameLayout>
