<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the widget picker on Android 12+. Mirrors the detailed layout
     with sample content, since the real city name is rendered at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:alpha="0.8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Berlin"
                android:textColor="@color/widget_text_secondary"
                android:textSize="22sp"
                android:fontFamily="@font/pacifico"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ 18°"
                android:textColor="@color/widget_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/red_hat_display" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextClock
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:timeZone="Europe/Berlin"
                android:textColor="@color/widget_text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/red_hat_display"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, d. MMM"
                android:format24Hour="EEE, d. MMM"
                android:timeZone="Europe/Berlin"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:fontFamily="@font/red_hat_display"
                android:alpha="0.9"
                android:singleLine="true"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="5dp"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
